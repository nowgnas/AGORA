# docker-compose.yml 에서 사용하는 환경변수 예시입니다.
# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요. (.env 는 커밋하지 않습니다)
HOST_NAME=
SCHEMA=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
REDISHOST=redis
REDISPASS=
MEETING_HOST=
MEETING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 호스트에 있는 GCP 서비스 계정 키 파일 경로
GCP_CREDENTIALS_FILE=./gcp-account-file.json
